<Window x:Class="RouterManager.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="飞书机器人 · 路由控制台" Icon="Assets/app-icon.ico" Width="1320" Height="860" MinWidth="1080" MinHeight="720" WindowStartupLocation="CenterScreen">
  <Grid Margin="26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="FEISHU / LOCAL CONTROL" FontSize="11" Foreground="{DynamicResource Accent}" FontWeight="Bold"/><TextBlock Text="机器人路由控制台" FontSize="29" FontWeight="SemiBold" Margin="0,7,0,5"/><TextBlock Text="在一个地方，看清机器人去向与运行状态。" Foreground="{DynamicResource Muted}"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="刷新状态" Click="Refresh_Click"/><Button Content="路由日志" Click="RouteLogs_Click"/><Button Content="设置" Click="Settings_Click"/><ComboBox x:Name="ThemeChoice" Width="140" Margin="5,0,0,0" SelectionChanged="Theme_Changed"><ComboBoxItem Content="跟随系统" Tag="system"/><ComboBoxItem Content="深色 · 黑" Tag="dark"/><ComboBoxItem Content="浅色 · 白" Tag="light"/></ComboBox></StackPanel></Grid>
    <Border Grid.Row="1" CornerRadius="10" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="16,12" Margin="0,0,0,18"><DockPanel><TextBlock Text="●  本地管理" Foreground="{DynamicResource Success}" FontWeight="SemiBold"/><TextBlock x:Name="Overview" Text="正在发现机器人…" Foreground="{DynamicResource Ink}" Margin="22,0,0,0"/><TextBlock DockPanel.Dock="Right" Text="自动刷新 · 5 秒" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right"/></DockPanel></Border>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <DockPanel><DockPanel DockPanel.Dock="Top" Margin="0,0,0,12"><Button x:Name="AddBotButton" DockPanel.Dock="Right" Content="＋ 新增" Click="AddBot_Click" Padding="10,5" Margin="0"/><TextBlock Text="机器人" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel><TextBox DockPanel.Dock="Top" x:Name="Search" ToolTip="搜索机器人、App ID 或后端" TextChanged="Search_Changed"/><ListBox x:Name="BotList" Background="Transparent" BorderThickness="0" SelectionChanged="BotList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><StackPanel><DockPanel><TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{Binding StatusLabel}" Foreground="{DynamicResource Success}" FontSize="11" HorizontalAlignment="Right" Margin="8,4,0,0"/></DockPanel><TextBlock Text="{Binding BackendLabel}" Foreground="{DynamicResource Muted}" Margin="0,9,0,5"/><TextBlock Text="{Binding AppId}" Foreground="{DynamicResource Muted}" FontSize="10" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel>
      <Border Grid.Column="2" CornerRadius="12" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="22"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><DockPanel><TextBlock x:Name="BotTitle" Text="选择一个机器人" FontSize="25" FontWeight="SemiBold"/><TextBlock x:Name="BusyBadge" Foreground="{DynamicResource Warning}" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel><TextBlock x:Name="BotSubtitle" Text="现有配置自动发现，凭据不会显示在界面中。" Foreground="{DynamicResource Muted}" Margin="0,7,0,16" TextWrapping="Wrap"/></StackPanel>
        <Border Grid.Row="1" Background="{DynamicResource ControlBg}" CornerRadius="9" Padding="17" Margin="0,0,0,20"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="50"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="飞书机器人" Foreground="{DynamicResource Muted}" FontSize="11"/><TextBlock x:Name="RouteBot" Text="—" FontSize="19" Margin="0,6,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="→" Foreground="{DynamicResource Accent}" FontSize="27" HorizontalAlignment="Center" VerticalAlignment="Center"/><StackPanel Grid.Column="2"><TextBlock Text="当前后端" Foreground="{DynamicResource Muted}" FontSize="11"/><TextBlock x:Name="RouteBackend" Text="—" FontSize="19" Margin="0,6,0,0"/></StackPanel></Grid></Border>
        <TabControl Grid.Row="2" x:Name="Tabs" Background="Transparent" BorderThickness="0"><TabItem Header="路由与服务"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,18,0,0"><TextBlock Text="目标后端"/><ComboBox x:Name="Backend" SelectedIndex="0"><ComboBoxItem Content="Codex CLI" Tag="codex"/><ComboBoxItem Content="Antigravity CLI" Tag="antigravity"/><ComboBoxItem Content="pi Agent" Tag="pi"/></ComboBox><TextBlock Text="工作目录"/><TextBox x:Name="Workspace"/><TextBlock Text="模型（default 表示使用后端默认值；pi 可填 provider/model）"/><DockPanel><Button DockPanel.Dock="Right" Content="读取模型" Click="ModelsRefresh_Click" Margin="8,5,0,12"/><ComboBox x:Name="Model" IsEditable="True" IsTextSearchEnabled="True" TextSearch.TextPath="Id" DisplayMemberPath="Display" SelectedValuePath="Id"/></DockPanel><TextBlock x:Name="ModelSource" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"/><TextBlock x:Name="PermissionLabel" Foreground="{DynamicResource Muted}" Margin="0,0,0,14" TextWrapping="Wrap"/><WrapPanel x:Name="Actions" Margin="0,0,0,18"><Button Content="保存并应用路由" Background="{DynamicResource PrimaryBg}" Foreground="{DynamicResource PrimaryText}" BorderBrush="{DynamicResource Accent}" Click="Apply_Click"/><Button Content="启动" Click="Start_Click"/><Button Content="停止" Click="Stop_Click"/><Button Content="重启" Click="Restart_Click"/><Button Content="专属 Skills" Click="Skills_Click"/><Button Content="自动路由" Click="AutoRoute_Click"/><Button Content="删除机器人" Click="DeleteBot_Click"/></WrapPanel><TextBlock x:Name="BotWarning" Foreground="{DynamicResource Warning}" TextWrapping="Wrap"/><TextBlock x:Name="RuntimeDetails" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/><TextBlock Text="切换自动备份配置；不同后端的会话分别保留。已有任务执行期间不能切换。" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,18,0,0"/></StackPanel></ScrollViewer></TabItem>
        <TabItem Header="实时日志"><Grid Margin="0,16,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><DockPanel><TextBlock Text="最近 160 行 · 自动隐藏凭据" Foreground="{DynamicResource Muted}"/><Button Content="打开日志目录" Click="OpenLogs_Click" HorizontalAlignment="Right" Padding="10,4" Margin="8,0,0,8"/></DockPanel><TextBox x:Name="Logs" Grid.Row="1" IsReadOnly="True" FontFamily="Cascadia Mono,Consolas" FontSize="11" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"/></Grid></TabItem><TabItem Header="Agent 额度"><Grid Margin="0,16,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><DockPanel><Button Content="立即查询额度" Click="QuotaRefresh_Click" DockPanel.Dock="Right"/><TextBlock x:Name="QuotaState" Text="定时查询默认关闭，可在设置中启用。" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/></DockPanel><TextBlock Grid.Row="1" Text="同一 Agent 账号由多个机器人共享；不支持的额度接口会明确标注。" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,14"/><DataGrid x:Name="QuotaGrid" Grid.Row="2"><DataGrid.Columns><DataGridTextColumn Header="Agent" Binding="{Binding AgentName}" Width="105"/><DataGridTextColumn Header="关联机器人" Binding="{Binding Robots}" Width="115"/><DataGridTextColumn Header="状态" Binding="{Binding StatusLabel}" Width="75"/><DataGridTextColumn Header="额度 / 查询说明" Binding="{Binding Detail}" Width="*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn><DataGridTextColumn Header="查询时间" Binding="{Binding CheckedTime}" Width="110"/></DataGrid.Columns></DataGrid></Grid></TabItem></TabControl>
      </Grid></Border>
    </Grid>
    <TextBlock Grid.Row="3" x:Name="Status" Text="就绪" Foreground="{DynamicResource Muted}" Margin="0,16,0,0" TextWrapping="Wrap"/>
  </Grid>
</Window>
